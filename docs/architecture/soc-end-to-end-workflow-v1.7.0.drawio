  <diagram id="p12" name="12 · Outcomes &amp; emails">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="p12-0" />
        <mxCell id="p12-1" parent="p12-0" />
        <mxCell id="p12-title" value="12 · Terminal outcomes, email triggers and OLA" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0f172a;fontFamily=Helvetica;" vertex="1" parent="p12-1">
          <mxGeometry x="20" y="12" width="2980" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p12-lane-OUT" value="Outcome" style="swimlane;horizontal=0;html=1;startSize=160;fontStyle=1;fontSize=15;fillColor=#f3fbf6;swimlaneFillColor=#f3fbf6;strokeColor=#d8e0e8;fontFamily=Helvetica;fontColor=#334155;swimlaneLine=1;" vertex="1" parent="p12-1">
          <mxGeometry x="0" y="140" width="3020" height="460" as="geometry" />
        </mxCell>
        <mxCell id="p12-lane-MAIL" value="Email notifications" style="swimlane;horizontal=0;html=1;startSize=160;fontStyle=1;fontSize=15;fillColor=#f8f9fa;swimlaneFillColor=#f8f9fa;strokeColor=#d8e0e8;fontFamily=Helvetica;fontColor=#334155;swimlaneLine=1;" vertex="1" parent="p12-1">
          <mxGeometry x="0" y="600" width="3020" height="900" as="geometry" />
        </mxCell>
        <mxCell id="p12-a" value="APPROVED&lt;br&gt;verified_by/at (Tier 2 verifier)&lt;br&gt;approved_by/at (closer) · closed_at&lt;br&gt;all write-once" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6f6ec;strokeColor=#34d399;fontColor=#065f46;fontSize=13;fontFamily=Helvetica;strokeWidth=1.5;spacing=8;shadow=0;" vertex="1" parent="p12-lane-OUT">
          <mxGeometry x="270.0" y="60.0" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p12-e" value="CLOSED_EVENT&lt;br&gt;closed_at · Response Requests&lt;br&gt;may outlive it" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6f6ec;strokeColor=#34d399;fontColor=#065f46;fontSize=13;fontFamily=Helvetica;strokeWidth=1.5;spacing=8;shadow=0;" vertex="1" parent="p12-lane-OUT">
          <mxGeometry x="650.0" y="70.0" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p12-c" value="CANCELLED&lt;br&gt;closed_at; excluded from&lt;br&gt;resolution &amp; MTTR stats" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fdecec;strokeColor=#dc3545;fontColor=#7f1d1d;fontSize=13;fontFamily=Helvetica;strokeWidth=1.5;spacing=8;shadow=0;" vertex="1" parent="p12-lane-OUT">
          <mxGeometry x="1030.0" y="70.0" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p12-f" value="All three: no transitions, no emergency changes, no step-back." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff9db;strokeColor=#e0b000;fontColor=#343a40;fontSize=13;fontFamily=Helvetica;strokeWidth=1.5;spacing=8;shadow=0;" vertex="1" parent="p12-lane-OUT">
          <mxGeometry x="1410.0" y="70.0" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p12-ola" value="OLA — alerts: 4 h triage from alert time (DETECTION, until triaged).&lt;br&gt;Tickets: contain deadline Critical 4 h · High 24 h · Unknown 4 h; Medium / Low none (badge hidden). Triage deadlines apply to every severity. Set once at creation; hidden on terminal tickets." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff9db;strokeColor=#e0b000;fontColor=#343a40;fontSize=13;fontFamily=Helvetica;strokeWidth=1.5;spacing=8;shadow=0;" vertex="1" parent="p12-lane-OUT">
          <mxGeometry x="2040.0" y="50.0" width="520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p12-mt" value="&lt;b&gt;Email triggers (as implemented)&lt;/b&gt;&lt;table style=&quot;font-size:14px;line-height:1.45;text-align:left&quot;&gt;&lt;tr&gt;&lt;th style=&quot;padding:7px 10px&quot;&gt;Recipient&lt;/th&gt;&lt;th style=&quot;padding:7px 10px&quot;&gt;When&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000;vertical-align:top&quot;&gt;&lt;b&gt;SOC Managers&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000&quot;&gt;→ PENDING_MGR_TRIAGE (create, submit, T1 route, Monitoring → Incident, project create once / Incident member add)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000;vertical-align:top&quot;&gt;&lt;b&gt;Assigned Admin&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000&quot;&gt;→ AWAITING_CONTAINMENT (manager forward, Project Review, send-back with reason)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000;vertical-align:top&quot;&gt;&lt;b&gt;Tier 2 staff (fallback: assigned_to)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000&quot;&gt;→ CONTAINMENT_REPORTED (not on step-back)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000;vertical-align:top&quot;&gt;&lt;b&gt;Response assignee&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000&quot;&gt;Response Request created&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000;vertical-align:top&quot;&gt;&lt;b&gt;SOC Managers&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000&quot;&gt;Response Request moves into DONE (every time)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000;vertical-align:top&quot;&gt;&lt;b&gt;SOC Managers&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000&quot;&gt;Cancellation requested&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000;vertical-align:top&quot;&gt;&lt;b&gt;Managers, requester, creator, admin, owner, subtask assignees&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000&quot;&gt;Direct cancel / approve / reject / withdraw&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000;vertical-align:top&quot;&gt;&lt;b&gt;⚠ System Owner (dormant)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000&quot;&gt;Ticket submitted; → APPROVED / CLOSED_EVENT — system_owner is not set by any form&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000;vertical-align:top&quot;&gt;&lt;b&gt;— no email —&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:7px 10px;border-bottom:1px solid #e0b000&quot;&gt;ESCALATED_T2, T1_REVIEW, AWAITING_OWNER forward (single ticket), owner reject, → PENDING_T2_REVIEW, → PENDING_MANAGER, → PENDING_MGR_EVENT_REVIEW, Monitoring start / conclude Event, step-back, emergency reassess, SUPERSEDED&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fffbe6;strokeColor=#d4a017;fontColor=#5c4400;fontSize=13;fontFamily=Helvetica;strokeWidth=1.5;spacing=8;shadow=0;arcSize=4;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="p12-lane-MAIL">
          <mxGeometry x="880.0" y="180.0" width="1320" height="520" as="geometry" />
        </mxCell>
        <mxCell id="p12-legend" value="READ LEFT → RIGHT · follow arrowheads across role lanes&lt;br&gt;Solid arrow: workflow / action &amp;nbsp; | &amp;nbsp; Dashed red: return / refusal / cancel &amp;nbsp; | &amp;nbsp; Dotted blue: email &amp;nbsp; | &amp;nbsp; Dotted gray, no arrow: note / condition &amp;nbsp; | &amp;nbsp; Line jumps: crossing, no join" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#475569;spacingLeft=20;" vertex="1" parent="p12-1">
          <mxGeometry as="geometry" x="0" y="60" width="3020" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
