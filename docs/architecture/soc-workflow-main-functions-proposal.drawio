        <mxCell id="footer" value="Function map, not a state-transition diagram. In the 12-page operational file, cards, page references, paired detail connectors and return navigation are clickable." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#475569;fontStyle=0;spacing=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="978" width="1580" height="28" />
