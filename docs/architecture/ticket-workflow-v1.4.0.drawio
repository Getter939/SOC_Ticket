  <diagram id="cancellation" name="2 · Cancellation (v1.4.0+)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="c0" />
        <mxCell id="c1" parent="c0" />

        <mxCell id="c_title" value="การยกเลิกรายการ (Ticket cancellation) — กระบวนการตรวจสอบได้ที่แยกจากการปิดเคส" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#212529;" vertex="1" parent="c1">
          <mxGeometry x="60" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_sub" value="เข้าทาง Ticket.cancellation_action เท่านั้น — เปลี่ยนสถานะทั่วไปเข้าสู่ CANCELLED ไม่ได้ · ADR-0005 · apps/incidents/cancellation.py" style="text;html=1;fontSize=11;fontColor=#6C757D;" vertex="1" parent="c1">
          <mxGeometry x="60" y="54" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c_any" value="&lt;b&gt;รายการอยู่ในสถานะที่ยังทำงานอยู่&lt;/b&gt;&lt;br&gt;NEW · ESCALATED_T2 · MONITORING · T1_REVIEW · PENDING_MGR_TRIAGE · AWAITING_CONTAINMENT · CONTAINMENT_REPORTED · AWAITING_OWNER · PENDING_T2_REVIEW · PENDING_MANAGER · PENDING_MGR_EVENT_REVIEW · (legacy OWNER_REMEDIATED)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8F9FA;strokeColor=#6C757D;fontColor=#343A40;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="60" y="100" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c_d1" value="ใครเป็นผู้ดำเนินการ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF0F2;strokeColor=#ADB5BD;fontColor=#343A40;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="170" y="250" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c_creator" value="&lt;b&gt;Tier 1 ผู้เปิดรายการ + สถานะยังเป็น NEW&lt;/b&gt;&lt;br&gt;ยกเลิกได้เอง (mode = CREATOR)&lt;br&gt;&lt;i&gt;ฟอร์มสร้างปกติจะส่งรายการต่อทันทีที่บันทึก จึงเกิดกรณีนี้ไม่บ่อย&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E7F0FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="600" y="100" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_mgr" value="&lt;b&gt;ผู้จัดการ SOC (หรือ superuser override)&lt;/b&gt;&lt;br&gt;ยกเลิกโดยตรง (mode = MANAGER)&lt;br&gt;ต้องมีเหตุผลและบันทึกตรวจสอบเหมือนกัน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFECE7;strokeColor=#FB7185;fontColor=#9F1239;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="600" y="215" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c_req" value="&lt;b&gt;ผู้เปิดรายการ หรือ ผู้ถือขั้นตอนปัจจุบัน&lt;/b&gt;&lt;br&gt;ยื่นคำขอยกเลิก (mode = REVIEW)&lt;br&gt;· claim ของ Tier 2 คนอื่นบล็อกการยื่น&lt;br&gt;· การถูกมอบหมาย Response Request อย่างเดียว &lt;u&gt;ไม่&lt;/u&gt; ให้สิทธิ์" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F1EBFE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="600" y="320" width="290" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c_form" value="&lt;b&gt;แบบฟอร์มเหตุผล (บังคับ)&lt;/b&gt;&lt;br&gt;รายการซ้ำ (DUPLICATE) · สร้างรายการผิด (CREATED_IN_ERROR) · เหตุผลอื่น (OTHER)&lt;br&gt;+ คำอธิบายเป็นข้อความ&lt;br&gt;&lt;i&gt;DUPLICATE ต้องอ้างรายการต้นฉบับที่เข้าถึงได้และยังไม่ถูกยกเลิก — ตรวจซ้ำอีกครั้งตอนอนุมัติ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF9E6;strokeColor=#E0B100;fontColor=#6B4E00;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="600" y="460" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_pending" value="&lt;b&gt;คำขอสถานะ PENDING — รออนุมัติ&lt;/b&gt;&lt;br&gt;ค้างได้ครั้งละ 1 คำขอต่อรายการ (unique constraint)&lt;br&gt;สถานะรายการและนาฬิกา OLA ไม่เปลี่ยน — งานเดินต่อตามปกติ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDECEC;strokeColor=#DC3545;fontColor=#7F1D1D;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="600" y="630" width="290" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c_d2" value="ผู้จัดการ SOC พิจารณา" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF0F2;strokeColor=#ADB5BD;fontColor=#343A40;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="645" y="780" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c_subtask" value="&lt;b&gt;เงื่อนไขก่อนอนุมัติ&lt;/b&gt;&lt;br&gt;งานย่อย / Response Request ที่ยังไม่จบ ต้อง &lt;i&gt;เสร็จสิ้น&lt;/i&gt; หรือถูกผู้จัดการ &lt;i&gt;เลือกให้ยกเลิก&lt;/i&gt; ทีละรายการ (ตรวจซ้ำกับงานจริงตอนอนุมัติ) → งานเหล่านั้นได้สถานะ CANCELLED ไม่ใช่ DONE" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF9E6;strokeColor=#E0B100;fontColor=#6B4E00;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c1">
          <mxGeometry x="180" y="770" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c_reject" value="&lt;b&gt;REJECTED — ไม่อนุมัติ&lt;/b&gt;&lt;br&gt;ขั้นตอนปัจจุบันคงเดิม ยื่นคำขอใหม่ได้" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8F9FA;strokeColor=#6C757D;fontColor=#343A40;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="1000" y="630" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_withdraw" value="&lt;b&gt;WITHDRAWN — ถอนคำขอ&lt;/b&gt;&lt;br&gt;เฉพาะผู้ยื่นเท่านั้น" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8F9FA;strokeColor=#6C757D;fontColor=#343A40;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="1000" y="710" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_super" value="&lt;b&gt;SUPERSEDED&lt;/b&gt;&lt;br&gt;รายการปิดตามปกติ (APPROVED / CLOSED_EVENT) ก่อนมีคำตัดสิน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8F9FA;strokeColor=#6C757D;fontColor=#343A40;fontSize=10;" vertex="1" parent="c1">
          <mxGeometry x="1000" y="790" width="250" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c_cancelled" value="&lt;b&gt;CANCELLED — ยกเลิกแล้ว&lt;/b&gt;&lt;br&gt;terminal · frozen · เปิดใหม่ไม่ได้&lt;br&gt;stamp closed_at แต่ &lt;u&gt;ไม่&lt;/u&gt; stamp approved_by / verified_by" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDECEC;strokeColor=#DC3545;fontColor=#7F1D1D;fontSize=11;" vertex="1" parent="c1">
          <mxGeometry x="600" y="950" width="290" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c_effect" value="&lt;b&gt;ผลหลังยกเลิก&lt;/b&gt;&lt;br&gt;· ออกจากคิวงานและแรงกดดัน OLA&lt;br&gt;· แสดงแยกในประวัติ / แดชบอร์ด / รายงาน (พร้อมคำตัดสิน)&lt;br&gt;· ไม่ถูกนับใน MTTR และอัตราการปิดสำเร็จ (mart)&lt;br&gt;· เก็บ ผู้ขอ · ผู้ตัดสิน · เหตุผล · เวลา · id งานที่ถูกยกเลิก · TicketLog ไว้ครบ&lt;br&gt;· หลักฐาน, Alert links, สมาชิก Project Incident และ classification ยังอยู่เหมือนเดิม&lt;br&gt;· Alert ที่ผูกไว้ &lt;u&gt;ไม่&lt;/u&gt; ถูกส่งกลับคิว triage" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#E6F6EC;strokeColor=#34D399;fontColor=#065F46;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c1">
          <mxGeometry x="1000" y="930" width="420" height="140" as="geometry" />
        </mxCell>

