  <diagram id="gates" name="3 · Gates &amp; parallel work">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="g0" />
        <mxCell id="g1" parent="g0" />

        <mxCell id="g_title" value="Response Requests (งานคู่ขนาน) และ ประตูควบคุมของ state machine" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#212529;" vertex="1" parent="g1">
          <mxGeometry x="60" y="20" width="1000" height="30" as="geometry" />
        </mxCell>

        <mxCell id="g_spawn" value="&lt;b&gt;ผู้จัดการ SOC เปิด Response Request&lt;/b&gt;&lt;br&gt;ได้ทุกขั้นตอนที่ยังทำงานอยู่ (TicketSubtask ชนิดพิเศษ)&lt;br&gt;auto-assign ให้ผู้ถือ role นั้น (ถ้ามีหลายคนจะให้เลือก)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFECE7;strokeColor=#FB7185;fontColor=#9F1239;fontSize=11;" vertex="1" parent="g1">
          <mxGeometry x="60" y="90" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="g_vapt" value="&lt;b&gt;VA / Pentest&lt;/b&gt; (VA_PT)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3E2;strokeColor=#F59E0B;fontColor=#8A4D0A;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="450" y="80" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g_infra" value="&lt;b&gt;Infrastructure Security&lt;/b&gt; (INFRA_SEC)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3E2;strokeColor=#F59E0B;fontColor=#8A4D0A;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="450" y="135" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g_forensic" value="&lt;b&gt;Forensics / RCA&lt;/b&gt; (FORENSIC_RCA)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3E2;strokeColor=#F59E0B;fontColor=#8A4D0A;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="450" y="190" width="230" height="40" as="geometry" />
        </mxCell>

        <mxCell id="g_rtm" value="&lt;b&gt;Red Team Manager&lt;/b&gt;&lt;br&gt;เห็นเฉพาะเคสที่มีคำขอของตน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F1EBFE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="750" y="90" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g_fa" value="&lt;b&gt;Forensic Analyst&lt;/b&gt;&lt;br&gt;อ่านทุกเคสได้ (read-only, v1.3.1)&lt;br&gt;เขียนได้เฉพาะผลงานในคำขอของตน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F1EBFE;strokeColor=#8B5CF6;fontColor=#5B21B6;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="750" y="175" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="g_flow" value="&lt;b&gt;คิว Response Requests&lt;/b&gt; (/incidents/response-requests/)&lt;br&gt;OPEN → IN_PROGRESS → DONE&lt;br&gt;(หรือ CANCELLED เมื่อยกเลิกรายการ — ดูหน้า 2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8F9FA;strokeColor=#6C757D;fontColor=#343A40;fontSize=10;" vertex="1" parent="g1">
          <mxGeometry x="1050" y="120" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="g_gate" value="&lt;b&gt;ประตูปิดเคส&lt;/b&gt;&lt;br&gt;ขณะยังมีคำขอที่ไม่ใช่ DONE — ทุกเส้นทางเข้า APPROVED ถูกบล็อก&lt;br&gt;(ทั้งเส้นที่ Tier 2 ปิดเอง และเส้นที่ผู้จัดการอนุมัติ) และปุ่ม Verify/ปิดเคสจะ &lt;i&gt;หายไป&lt;/i&gt; ไม่ใช่แค่ถูกปฏิเสธตอนกด&lt;br&gt;&lt;b&gt;ข้อยกเว้น:&lt;/b&gt; CLOSED_EVENT ยังปิดได้ — คำขอที่ค้างอยู่จะอยู่ต่อไป" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDECEC;strokeColor=#DC3545;fontColor=#7F1D1D;fontSize=11;" vertex="1" parent="g1">
          <mxGeometry x="1050" y="250" width="290" height="130" as="geometry" />
        </mxCell>

        <mxCell id="g_rules" value="&lt;b&gt;ประตูควบคุมอื่น ๆ ที่ state machine บังคับ&lt;/b&gt;&#10;&#10;1. Tier 2 claim — ต้อง claim ก่อนดำเนินการ; claim ของคนอื่นบล็อกใน transition_to; claim ถูกล้างทุกครั้งที่เปลี่ยนสถานะ (คิวครอบ 3 ขั้นตอน)&#10;&#10;2. t1_route — Tier 1 กำหนดเลน (ADMIN/OWNER) ตอนส่งเข้า PENDING_MGR_TRIAGE; ผู้จัดการ &quot;ตรวจและ flag&quot; ได้ แต่สลับเลนไม่ได้&#10;&#10;3. Emergency — ผู้จัดการเท่านั้น (superuser bypass); ประเมินครั้งแรกเป็นข้อบังคับที่ PENDING_MGR_TRIAGE (write-once ทั้ง Normal และ Emergency); reassess ได้ภายหลังพร้อมเหตุผล แต่ไม่ได้ที่ PENDING_MGR_TRIAGE และไม่ได้หลังปิดเคส&#10;&#10;4. requires_manager_verification = is_emergency เท่านั้น — ความรุนแรงระดับ Critical ไม่ทำให้ต้องผ่านผู้จัดการ&#10;&#10;5. MONITORING — เข้าได้เฉพาะจาก ESCALATED_T2 โดย Tier 2, ครั้งเดียวต่อเคส (has_been_monitored), 30 วันคงที่ ปรับไม่ได้&#10;&#10;6. Event downgrade โดย Tier 2 ต้องผ่านผู้จัดการ (PENDING_MGR_EVENT_REVIEW) — แต่การปรับเป็น Event กลางเลน containment/owner ⚠ ยังข้ามผู้จัดการอยู่ (asymmetry ที่ตัดสินใจไว้ 2026-07-23)&#10;&#10;7. Manager step-back — ย้อนกลับได้เฉพาะขอบใน STEP_BACK_EDGES และผ่าน transition_to เดิม เพื่อรักษา invariant/audit ทั้งหมด&#10;&#10;8. CANCELLED เข้าได้ทาง cancellation_action เท่านั้น ไม่ใช่ dropdown สถานะ" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF9E6;strokeColor=#E0B100;fontColor=#6B4E00;fontSize=11;align=left;spacingLeft=8;spacingTop=4;verticalAlign=top;" vertex="1" parent="g1">
          <mxGeometry x="60" y="300" width="920" height="620" as="geometry" />
        </mxCell>

        <mxCell id="ge1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C757D;" edge="1" parent="g1" source="g_spawn" target="g_vapt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C757D;" edge="1" parent="g1" source="g_spawn" target="g_infra">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C757D;" edge="1" parent="g1" source="g_spawn" target="g_forensic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C757D;" edge="1" parent="g1" source="g_vapt" target="g_rtm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C757D;" edge="1" parent="g1" source="g_infra" target="g_rtm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C757D;" edge="1" parent="g1" source="g_forensic" target="g_fa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C757D;" edge="1" parent="g1" source="g_rtm" target="g_flow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C757D;" edge="1" parent="g1" source="g_fa" target="g_flow">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge9" value="ยังไม่ DONE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#DC3545;fontColor=#7F1D1D;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="g1" source="g_flow" target="g_gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
