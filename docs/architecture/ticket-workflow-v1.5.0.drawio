        <mxCell id="p4_controls" value="&lt;b&gt;1 · Tier 2 claim&lt;/b&gt;&lt;br&gt;ต้อง claim ก่อนทำงาน · claim ของผู้อื่นบล็อก transition · ล้าง claim ทุกครั้งที่เปลี่ยนสถานะ&lt;br&gt;&lt;br&gt;&lt;b&gt;2 · t1_route&lt;/b&gt;&lt;br&gt;Tier 1 ล็อก ADMIN / OWNER ก่อนเข้า PENDING_MGR_TRIAGE · Manager สลับเลนไม่ได้&lt;br&gt;&lt;br&gt;&lt;b&gt;3 · Emergency&lt;/b&gt;&lt;br&gt;Manager เท่านั้นที่ตั้งหรือแก้ · initial assessment บังคับ · requires_manager_verification = is_emergency เท่านั้น&lt;br&gt;&lt;br&gt;&lt;b&gt;4 · Manager step-back&lt;/b&gt;&lt;br&gt;AWAITING_CONTAINMENT → PENDING_MGR_TRIAGE&lt;br&gt;AWAITING_OWNER → PENDING_MGR_TRIAGE&lt;br&gt;PENDING_MANAGER → CONTAINMENT_REPORTED / PENDING_T2_REVIEW&lt;br&gt;&lt;br&gt;&lt;b&gt;5 · Cancellation entry&lt;/b&gt;&lt;br&gt;เข้า CANCELLED ผ่าน cancellation_action เท่านั้น ไม่ใช่ status dropdown" style="fontFamily=Tahoma;shape=note;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.3;fontColor=#334155;fontSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="p4_1">
          <mxGeometry x="1050" y="525" width="570" height="420" as="geometry" />
        </mxCell>
        <mxCell id="p4_legacy" value="&lt;b&gt;OWNER_REMEDIATED · LEGACY&lt;/b&gt;&lt;br&gt;ไม่มี live edge เข้าสถานะนี้&lt;br&gt;ตั๋วเก่าเดินต่อไป PENDING_T2_REVIEW ได้&lt;br&gt;Manager step-back กลับ AWAITING_OWNER ได้" style="fontFamily=Tahoma;rounded=1;whiteSpace=wrap;html=1;arcSize=10;dashed=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#64748B;fontSize=10;spacing=8;" vertex="1" parent="p4_1">
          <mxGeometry x="1660" y="555" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4_asymmetry" value="&lt;b&gt;Known asymmetry · 2026-07-23&lt;/b&gt;&lt;br&gt;Tier 2 downgrade ที่ ESCALATED_T2 ต้องผ่าน Manager แต่การปรับเป็น Event กลาง Admin / Owner lane ยังปิด CLOSED_EVENT ได้โดยตรง แม้เป็น Emergency" style="fontFamily=Tahoma;shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.3;fontColor=#78350F;fontSize=10;align=left;spacing=8;" vertex="1" parent="p4_1">
          <mxGeometry x="1660" y="735" width="270" height="150" as="geometry" />
