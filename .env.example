# Copy this file to .env and fill in your values
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)
#
# ─────────────────────────────────────────────────────────────────────────────
# DO NOT COPY THIS FILE VERBATIM ONTO THE WINDOWS PRODUCTION SERVER.
#
# It is written for the SUPERSEDED Docker/nginx/gunicorn stack: Linux paths, a
# `web` service hostname, and BACKUP_*/RESTORE_* keys that no Python code and
# none of the PowerShell backup scripts read. Copying it wholesale is how the
# current production .env acquired dead keys and a bogus ALLOWED_HOSTS entry.
#
# For the real production platform (Windows Server + native PostgreSQL +
# Waitress under NSSM + IIS/ARR), build .env from the template in
# docs/operations/production-deployment.windows.md Stage 5 instead.
#
# Windows note: PowerShell's `Set-Content -Encoding utf8` writes a BOM, which
# turns the first key into "﻿SECRET_KEY" and makes python-decouple raise
# UndefinedValueError at startup. Edit .env in a plain text editor.
# ─────────────────────────────────────────────────────────────────────────────

SECRET_KEY=your-django-secret-key-here
# Required, separate Fernet encryption key. See the MFA operations runbook.
# Generate locally: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEYS=replace-with-a-generated-fernet-key
# Master switch for the 2FA requirement. Default True. Set to False to log in
# with password only and skip enrolment/verification (temporary). Enrolled
# devices are preserved; set back to True to re-enable 2FA unchanged.
MFA_ENABLED=True
# Quote values containing `$`, `#`, spaces, or other shell-like characters with
# single quotes. Docker Compose interpolates unquoted dollar-sign expressions.

# Set DEBUG=False in any non-local deployment. DEBUG=True leaks stack traces,
# settings, and SQL to anyone who triggers an error. Default is False so an
# accidental copy-to-prod stays safe; flip to True only for local development.
DEBUG=False

# Comma-separated list of hostnames/IPs this server will respond to (no
# spaces). Must include the LAN IP/hostname other users browse to, plus
# "web" for the Docker service-to-service requests behind nginx.
ALLOWED_HOSTS=192.168.x.x,localhost,127.0.0.1,web

# ── HTTPS security (production behind TLS) ──────────────────────────────────
# The production compose stack terminates TLS itself and enforces these values.
# Keep them enabled for any non-local deployment.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
PASSWORD_RESET_USE_HTTPS=True
USE_PROXY_SSL_HEADER=True
TRUST_X_FORWARDED_FOR=True

# REQUIRED once TLS is live. On a secure request Django checks the Origin header
# against this list; if it is empty every form POST fails with "Origin checking
# failed". Comma-separated, full scheme+host, no path. Set this in the SAME
# change that enables SECURE_SSL_REDIRECT — not afterwards.
CSRF_TRUSTED_ORIGINS=https://soc.example.com

# ── Session idle timeout ────────────────────────────────────────────────────
# Minutes of inactivity before a session expires. The window slides on every
# request, so an analyst actively working is never logged out mid-task; it only
# catches a console left logged in and walked away from. Raise for UAT if
# testers find it disruptive; most SOC baselines want 15-30.
SESSION_IDLE_MINUTES=30

# Host paths for the certificate and private key mounted into the production
# nginx container. Obtain these from your ACME/corporate PKI workflow.
TLS_CERT_PATH=/etc/letsencrypt/live/soc.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/soc.example.com/privkey.pem

DB_NAME=ticketdata
DB_USER=ticket
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

CSV_DIR=

# ── Email / SMTP ──────────────────────────────────────────────────────────
# EMAIL_BACKEND: leave unset for real SMTP. On a UAT/demo box, set it to the
# console backend so notifications print to the container log instead of
# emailing real recipients:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# EMAIL_PORT: use 587 (STARTTLS) with EMAIL_USE_TLS=True  ← recommended
#             use 465 (SMTPS)   with EMAIL_USE_SSL=True, EMAIL_USE_TLS=False
#             do NOT combine port 25 with EMAIL_USE_TLS=True
EMAIL_HOST=smtp.your-provider.com
EMAIL_HOST_USER=your-smtp-username@example.com
EMAIL_HOST_PASSWORD=your-smtp-password-here
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL: the "From:" address on outgoing emails.
# Defaults to EMAIL_HOST_USER when not set.
DEFAULT_FROM_EMAIL=SOC Notifications <noreply@example.com>

# ── Site URL ──────────────────────────────────────────────────────────────
# Used to build absolute links in email notifications.
# No trailing slash. Set to your public hostname in production.
SITE_URL=http://localhost:8088

# ── Login lockout protection ───────────────────────────────────────────────
# A username/IP pair is temporarily locked after this many failed attempts.
# The default values are 5 failures and a 15-minute cool-off period.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# ── Wazuh / OpenSearch alert ingestion ─────────────────────────────────────
# OpenSearch REST API — alerts live at https://<HOST>:<PORT>/wazuh-alerts-*/_search
# Auth is HTTP Basic. Always verify the server certificate. For a self-signed
# cluster, install/export its CA as a PEM file and point OPENSEARCH_CA_BUNDLE
# at it. If set, that bundle takes precedence over system trust roots.
OPENSEARCH_HOST=10.x.x.x
OPENSEARCH_PORT=9200
OPENSEARCH_USER=your_opensearch_user
OPENSEARCH_PASSWORD=your_opensearch_password
OPENSEARCH_VERIFY_SSL=True
# Host path mounted by docker-compose.prod.yml, and its corresponding path in
# the web container. Both are required by the production stack.
OPENSEARCH_CA_HOST_PATH=/etc/soc-ticket/certs/opensearch-ca.pem
OPENSEARCH_CA_BUNDLE=/etc/ssl/certs/opensearch-ca.pem

# Backup / restore verification
# On the VM, prefer a path outside the repo, e.g. /srv/soc-ticket/backups or a
# mounted backup disk. The default is convenient for local testing and is
# ignored by git.
BACKUP_HOST_PATH=./backups
BACKUP_PREFIX=soc_ticket

# The backup job uses BACKUP_TIER in the filename and retention cleanup. Use
# manual for ad-hoc runs, then set hourly/daily/weekly/monthly from cron or a
# systemd timer.
BACKUP_TIER=manual
BACKUP_RETENTION_ENABLED=true
BACKUP_RETENTION_HOURLY_DAYS=2
BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_WEEKLY_DAYS=84
BACKUP_RETENTION_MONTHLY_DAYS=365

# Encryption is required by default. Prefer a password file or GPG recipient
# instead of placing a long-lived password directly in .env.
BACKUP_ENCRYPTION=openssl
# BACKUP_ENCRYPTION_PASSWORD_FILE=/run/secrets/soc_ticket_backup_password
# BACKUP_ENCRYPTION_PASSWORD=change-me-only-if-you-accept-env-secret-risk
# BACKUP_GPG_RECIPIENT=security-backups@example.com
# Set only for disposable local testing; production backups must remain encrypted.
# BACKUP_ALLOW_UNENCRYPTED=true

# Restore verification recreates this database and compares row/media counts.
RESTORE_DB=ticketdata_restoretest
RESTORE_DROP_AFTER_TEST=false

# Keep connections open in a deployed environment. Set to 0 only when a
# short-lived command or an external connection pool requires it.
DB_CONN_MAX_AGE=300
DB_SSLMODE=prefer

# ── Application logging ─────────────────────────────────────────────────────
# LOG_DIR MUST point outside the application tree. On the Windows server the
# app directory is read-execute only for the service account, so leaving this
# at its default (<BASE_DIR>/logs) means RotatingFileHandler cannot open its
# file and settings import fails at service start.
LOG_DIR=C:\SOCTicket\logs
LOG_LEVEL=INFO

# Reported by /healthz so a deployment can be identified after a release.
# Left as "unknown" when unset — never defaults to a git SHA.
APP_VERSION=unknown

# ── Wazuh alert retention ───────────────────────────────────────────────────
# Window used by `manage.py purge_wazuh_alerts`. Alerts linked to a ticket, a
# TicketAlertLink, or a project incident are never deleted at any age, and
# neither are alerts still PENDING or TRIAGING. Agree the value with compliance
# before the first production run.
WAZUH_RETENTION_DAYS=90
